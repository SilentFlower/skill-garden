# torrent-analyze 默认配置
# 修改此文件即可调整 skill 的默认行为。
# 优先级：命令行参数 > shell 环境变量 > 本文件 > 脚本内置默认值。

# 缓存与渲染输出目录。
TORRENT_ANALYZE_CACHE_DIR=.torrent-analyze

# whatslink.info 请求重试配置。
TORRENT_ANALYZE_RETRY_TIMES=20
TORRENT_ANALYZE_RETRY_INTERVAL=3.0

# 从上下文自动识别多条磁链/hash时的处理上限，脚本会裁剪到 1..20。
TORRENT_ANALYZE_MAX_ITEMS=20

# 是否默认生成截图拼图。开启后存在截图时会输出 rendered/torrent_<hash>.jpg。
TORRENT_ANALYZE_IMAGE=false

# 截图高斯模糊半径，范围 0..10。
TORRENT_ANALYZE_BLUR=5

# 字体查找配置。
# TORRENT_ANALYZE_FONT_FILE 是字体文件绝对路径，优先级最高。
# 留空时按 TORRENT_ANALYZE_FONT_DIR/font.ttf、MapleMono、系统中文字体、自动下载字体顺序查找。
TORRENT_ANALYZE_FONT_FILE=
TORRENT_ANALYZE_FONT_DIR=/AstrBot/data/fonts
TORRENT_ANALYZE_FONT_FILENAME=

# 找不到本地中文字体时自动下载 Noto Sans CJK SC 到缓存目录。
# TORRENT_ANALYZE_FONT_CACHE_DIR 留空时使用 TORRENT_ANALYZE_CACHE_DIR/fonts。
TORRENT_ANALYZE_AUTO_DOWNLOAD_FONT=true
TORRENT_ANALYZE_FONT_URL=https://github.com/notofonts/noto-cjk/raw/main/Sans/OTF/SimplifiedChinese/NotoSansCJKsc-Regular.otf
TORRENT_ANALYZE_FONT_CACHE_DIR=
TORRENT_ANALYZE_FONT_CACHE_FILENAME=NotoSansCJKsc-Regular.otf

# 是否默认输出 JSON。
TORRENT_ANALYZE_JSON=false

# 是否默认禁用缓存并强制请求 whatslink.info。
TORRENT_ANALYZE_NO_CACHE=false
