# 用户可主动安装到 ~/.config/aliyun-ops/env，并保持文件权限为 600。
# 安装或升级 Skill 不会自动创建、复制、合并、改写或删除真实 ENV 文件。
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=

# DMS：Tid 可不填，脚本会自动读取当前激活租户。
ALIYUN_DMS_TID=

# SLS：也可以通过命令行参数临时覆盖。
ALIYUN_SLS_PROJECT=
ALIYUN_SLS_LOGSTORE=
ALIYUN_SLS_REGION=cn-hangzhou

# MSE：endpoint 留空时由 region 自动生成。
ALIYUN_MSE_REGION=cn-hangzhou
ALIYUN_MSE_ENDPOINT=
