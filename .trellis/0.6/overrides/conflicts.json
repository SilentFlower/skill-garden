{
  "schemaVersion": 1,
  "rules": [
    {
      "id": "workflow-no-direct-dispatch-routing",
      "severity": "error",
      "target": ".trellis/workflow.md",
      "whenOperations": [
        "workflow-active-task-routing"
      ],
      "assertion": {
        "type": "absent-literal",
        "values": [
          "- `in_progress` implementation/check -> dispatch `trellis-implement` / `trellis-check`.",
          "- Before editing -> `trellis-before-dev`; after editing -> `trellis-check`."
        ]
      },
      "owner": "trellis-route",
      "reason": "Phase 2.1/2.2 必须先解析 route_decision，不能由上游 routing 表直接选择执行模式。"
    },
    {
      "id": "workflow-no-direct-implement-walkthrough",
      "severity": "error",
      "target": ".trellis/workflow.md",
      "whenOperations": [
        "workflow-phase-2-implement"
      ],
      "assertion": {
        "type": "absent-literal",
        "values": [
          "Spawn the implement sub-agent:"
        ]
      },
      "owner": "trellis-route",
      "reason": "Phase 2.1 只负责进入 trellis-route，具体 inline/subagent 执行由 route 结果所有。"
    },
    {
      "id": "workflow-no-auto-fix-check",
      "severity": "error",
      "target": ".trellis/workflow.md",
      "whenOperations": [
        "workflow-phase-2-check"
      ],
      "assertion": {
        "type": "absent-literal",
        "values": [
          "- Auto-fix issues it finds",
          "If issues are found → fix → re-check, until green."
        ]
      },
      "owner": "trellis-check-all",
      "reason": "Check-All 必须 audit-only collect-all，修复只能在统一报告后获得授权。"
    },
    {
      "id": "workflow-no-local-only-commit",
      "severity": "error",
      "target": ".trellis/workflow.md",
      "whenOperations": [
        "workflow-phase-3-commit"
      ],
      "assertion": {
        "type": "absent-literal",
        "values": [
          "Proposed commits (in order):",
          "Never push to remote in this step."
        ]
      },
      "owner": "trellis-push",
      "reason": "Phase 3.4 普通模式由 trellis-push 执行 exact commit + push。"
    },
    {
      "id": "workflow-required-route-pointer",
      "severity": "error",
      "target": ".trellis/workflow.md",
      "whenOperations": [
        "workflow-phase-2-implement",
        "workflow-phase-2-check"
      ],
      "assertion": {
        "type": "required-literal",
        "values": [
          "<!-- BEGIN skill-garden patch workflow-phase-2-implement v0.6 -->\n#### 2.1 Implement `[required · repeatable]`\n\nImplementation requires an active `in_progress` task and reviewed planning artifacts. Run `trellis-route(target=implement)` before editing or dispatching.",
          "<!-- BEGIN skill-garden patch workflow-phase-2-check v0.6 -->\n#### 2.2 Quality check `[required · repeatable]`\n\nRun `trellis-route(target=check)`, then execute the unified `trellis-check-all` entry using the validated inline/subagent route."
        ]
      },
      "owner": "trellis-route",
      "reason": "Phase 2.1/2.2 的受管 section 必须保留统一 route 入口。"
    },
    {
      "id": "workflow-required-finish-pointers",
      "severity": "error",
      "target": ".trellis/workflow.md",
      "whenOperations": [
        "workflow-phase-3-update-spec",
        "workflow-phase-3-commit"
      ],
      "assertion": {
        "type": "required-literal",
        "values": [
          "<!-- BEGIN skill-garden patch workflow-phase-3-update-spec v0.6 -->\n#### 3.3 Spec update `[required · once]`\n\nLoad `trellis-update-spec` and let it decide whether the task produced executable knowledge that must be recorded.",
          "<!-- BEGIN skill-garden patch workflow-phase-3-commit v0.6 -->\n#### 3.4 Commit changes `[required · once]`\n\nLoad `trellis-push`. It owns dirty-file classification, exact file/message planning, one-shot confirmation, Git safety checks, ordinary commit + push, and current-task progress synchronization."
        ]
      },
      "owner": "workflow-phase-ownership",
      "reason": "Phase 3.3/3.4 的受管 section 必须保留到权威 Skill 的一跳入口。"
    },
    {
      "id": "workflow-required-task-brief-review",
      "severity": "error",
      "target": ".trellis/workflow.md",
      "whenOperations": [
        "workflow-phase-1-activate"
      ],
      "assertion": {
        "type": "required-literal",
        "values": [
          "<!-- BEGIN skill-garden patch workflow-phase-1-activate v0.6 -->\n#### 1.4 Activate task `[required · once]`\n\nBefore changing task status, load `trellis-task-brief`",
          "display the full brief in chat, then stop the current turn and wait for planning review confirmation"
        ]
      },
      "owner": "trellis-task-brief",
      "reason": "Phase 1.4 必须自包含 brief 展示、停止和后续确认门禁。"
    },
    {
      "id": "brainstorm-required-planning-handoff",
      "severity": "error",
      "target": ".agents/skills/trellis-brainstorm/SKILL.md",
      "whenOperations": [
        "brainstorm-planning-handoff",
        "brainstorm-planning-readiness"
      ],
      "assertion": {
        "type": "required-literal",
        "values": [
          "<!-- BEGIN skill-garden patch brainstorm-planning-handoff v0.6 -->\n## Planning Handoff",
          "<!-- BEGIN skill-garden patch brainstorm-planning-readiness v0.6 -->\n- Planning artifacts are ready for the final brief handoff.",
          "Implementation intent expressed before the final artifacts and full brief are shown authorizes planning only",
          "unresolved items are `- [ ]`",
          "Do not write bare placeholders"
        ]
      },
      "owner": "trellis-brainstorm",
      "reason": "Brainstorm 收尾必须交给 task brief review，不能复用早期实现意向。"
    },
    {
      "id": "brainstorm-required-planning-handoff-claude",
      "severity": "error",
      "target": ".claude/skills/trellis-brainstorm/SKILL.md",
      "whenOperations": [
        "brainstorm-planning-handoff",
        "brainstorm-planning-readiness"
      ],
      "assertion": {
        "type": "required-literal",
        "values": [
          "<!-- BEGIN skill-garden patch brainstorm-planning-handoff v0.6 -->\n## Planning Handoff",
          "<!-- BEGIN skill-garden patch brainstorm-planning-readiness v0.6 -->\n- Planning artifacts are ready for the final brief handoff.",
          "Implementation intent expressed before the final artifacts and full brief are shown authorizes planning only",
          "unresolved items are `- [ ]`",
          "Do not write bare placeholders"
        ]
      },
      "owner": "trellis-brainstorm",
      "reason": "Claude 的 Brainstorm 最终入口必须保留相同 planning handoff。"
    },
    {
      "id": "task-start-required-brief-gate",
      "severity": "error",
      "target": ".trellis/scripts/task.py",
      "whenOperations": [
        "task-start-brief-validator",
        "task-start-brief-guard",
        "task-start-degraded-write-gate",
        "task-start-session-write-gate"
      ],
      "assertion": {
        "type": "required-literal",
        "values": [
          "# BEGIN skill-garden patch task-start-brief-validator v0.6",
          "# BEGIN skill-garden patch task-start-brief-guard v0.6",
          "# BEGIN skill-garden patch task-start-degraded-write-gate v0.6",
          "# BEGIN skill-garden patch task-start-session-write-gate v0.6",
          "Error: Planning task brief.md is missing.",
          "Error: Planning task brief.md is stale; newer artifacts:",
          "Error: Failed to persist task status before start.",
          "Task status rollback also failed"
        ]
      },
      "owner": "task-start-brief-gate",
      "reason": "planning → in_progress 前必须确定性阻断缺失或过期 brief。"
    },
    {
      "id": "active-task-required-clear-integrity",
      "severity": "error",
      "target": ".trellis/scripts/common/active_task.py",
      "whenOperations": [
        "active-task-clear-result-type",
        "active-task-clear-read-result",
        "active-task-clear-session-fallback"
      ],
      "assertion": {
        "type": "required-literal",
        "values": [
          "# BEGIN skill-garden patch active-task-clear-read-result v0.6",
          "class ClearActiveTaskResult:",
          "session-file-delete-failed",
          "session-runtime-{context_result['status']}"
        ]
      },
      "owner": "active-task-clear",
      "reason": "finish 清理必须返回结构化结果，并保留损坏 session 证据和删除失败。"
    },
    {
      "id": "active-task-required-runtime-integrity",
      "severity": "error",
      "target": ".trellis/scripts/common/active_task.py",
      "whenOperations": [
        "active-task-runtime-json-io",
        "active-task-runtime-resolution",
        "active-task-runtime-fallback",
        "active-task-runtime-set"
      ],
      "assertion": {
        "type": "required-literal",
        "values": [
          "# BEGIN skill-garden patch active-task-runtime-json-io v0.6",
          "os.replace(temp_path, path)",
          "session-{result['status']}",
          "Set the active task without overwriting corrupt session runtime state."
        ]
      },
      "owner": "active-task-runtime",
      "reason": "full-only runtime Patch 必须原子写入，并阻止损坏 session 被 fallback 或覆盖。"
    },
    {
      "id": "task-finish-required-clear-result",
      "severity": "error",
      "target": ".trellis/scripts/task.py",
      "whenOperations": ["task-finish-clear-result"],
      "assertion": {
        "type": "required-literal",
        "values": [
          "# BEGIN skill-garden patch task-finish-clear-result v0.6",
          "if not result.cleared:",
          "Failed to clear current task"
        ]
      },
      "owner": "task-finish",
      "reason": "finish 只有在 session pointer 实际清除后才能报告成功并执行 hook。"
    },
    {
      "id": "task-store-required-write-integrity",
      "severity": "error",
      "target": ".trellis/scripts/common/task_store.py",
      "whenOperations": [
        "task-store-write-helpers",
        "task-create-duplicate-slug",
        "task-create-initial-write",
        "task-create-parent-link",
        "task-create-active-warning",
        "task-archive-metadata-guard",
        "task-add-subtask-pair-write",
        "task-remove-subtask-pair-write",
        "task-archive-status-write",
        "task-set-branch-write",
        "task-set-base-branch-write",
        "task-set-scope-write"
      ],
      "assertion": {
        "type": "required-literal",
        "values": [
          "# BEGIN skill-garden patch task-store-write-helpers v0.6",
          "def _write_task_pair(",
          "Error: Task directory already exists:",
          "Failed to write initial task.json",
          "Relationship rollback incomplete",
          "Failed to persist completed task status",
          "Task was created, but the active-task pointer could not be persisted.",
          "task.json not found or invalid:",
          "Failed to persist branch",
          "Failed to persist base branch",
          "Failed to persist scope"
        ]
      },
      "owner": "task-store",
      "reason": "task store 核心命令不得在关键 JSON 写入失败后继续输出成功。"
    },
    {
      "id": "paths-required-clear-result",
      "severity": "error",
      "target": ".trellis/scripts/common/paths.py",
      "whenOperations": ["paths-clear-current-result"],
      "assertion": {
        "type": "required-literal",
        "values": [
          "# BEGIN skill-garden patch paths-clear-current-result v0.6",
          "return result.cleared"
        ]
      },
      "owner": "active-task-clear",
      "reason": "paths 兼容入口必须传播 session 清理的真实结果。"
    },
    {
      "id": "workflow-no-covering-language",
      "severity": "error",
      "target": ".trellis/workflow.md",
      "whenOperations": [
        "workflow-hub",
        "workflow-active-task-routing",
        "workflow-phase-3-commit"
      ],
      "assertion": {
        "type": "absent-literal",
        "values": [
          "HIGHEST PRIORITY: skill-garden overrides",
          "This hub overrides any conflicting Trellis workflow",
          "overrides lower \"Active Task Routing\"",
          "fully supersedes the lower Phase 3.4 walkthrough"
        ]
      },
      "owner": "workflow-phase-ownership",
      "reason": "冲突正文应被结构化替换，Hub 不再通过优先级文字压制下层协议。"
    },
    {
      "id": "workflow-state-hub-pointer-budget",
      "severity": "warning",
      "target": ".trellis/workflow.md",
      "whenOperations": [
        "workflow-state-in-progress",
        "workflow-state-in-progress-inline"
      ],
      "assertion": {
        "type": "max-occurrences",
        "value": "The Workflow Hub is the source of truth for Task Brief, Routing, Post-Check, Commit, and Task Progress gates.",
        "max": 0
      },
      "owner": "workflow-state",
      "reason": "该 Hub 职责句已从两个 in-progress state 删除，任一回流都需要重新评审。"
    }
  ]
}
